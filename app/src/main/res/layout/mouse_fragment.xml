<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    tools:context="com.example.alek.ble_hid_example.MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/mouse"
                android:textAlignment="center"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Mouse Buttons Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1f2937"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#374151"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mouse_button_mouse_1"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            app:icon="@drawable/ic_looks_one_black_24dp"
                            app:iconTint="@color/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mouse_button_mouse_2"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            app:icon="@drawable/ic_looks_two_black_24dp"
                            app:iconTint="@color/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mouse_button_mouse_3"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            app:icon="@drawable/ic_looks_3_black_24dp"
                            app:iconTint="@color/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mouse_button_mouse_4"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            app:icon="@drawable/ic_looks_4_black_24dp"
                            app:iconTint="@color/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mouse_button_mouse_5"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            app:icon="@drawable/ic_looks_5_black_24dp"
                            app:iconTint="@color/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Touchpad area -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/touchpad"
                android:textAlignment="center"
                android:textColor="@color/colorOnSurface"
                android:textStyle="italic" />

            <View
                android:id="@+id/mouse_mouse_cursor"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/touchpad_bg"
                android:elevation="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/horizontal_scroll"
                android:textAlignment="center"
                android:textColor="@color/colorOnSurface" />

            <View
                android:id="@+id/mouse_h_scroll"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/touchpad_bg" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/mouse_text_device_info"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="8dp"
        android:background="@drawable/device_info_bg"
        android:gravity="center"
        android:text="@string/device_not_connected"
        android:textColor="@color/colorWhite"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
