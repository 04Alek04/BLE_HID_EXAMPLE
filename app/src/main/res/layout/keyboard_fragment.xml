<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="com.example.alek.ble_hid_example.MainActivity">

    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/keyboard_sub_main_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="beforeDescendants"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:weightSum="1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/keyboard"
                android:textAlignment="center"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/activity_text_big" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/keyboard_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_text"
                    android:nextFocusLeft="@id/keyboard_edit_text"
                    android:nextFocusUp="@id/keyboard_edit_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keyboard_button_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/send_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/send_single_character"
                android:textAlignment="center"
                android:textColor="?android:attr/textColorSecondary" />

            <Spinner
                android:id="@+id/keyboard_spinner_character"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dialog" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keyboard_toggle_kb"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checkable="true"
                android:text="@string/keyboard_off"
                android:textColor="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:paddingTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyboard_lock_num"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="NUM"
                    android:textColor="?attr/colorOnSurface"
                    app:strokeColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyboard_lock_caps"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="CAPS"
                    android:textColor="?attr/colorOnSurface"
                    app:strokeColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyboard_lock_scroll"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="SCRL"
                    android:textColor="?attr/colorOnSurface"
                    app:strokeColor="?attr/colorOnSurface" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Shortcuts (CTRL+)"
                android:textAlignment="center"
                android:textColor="?android:attr/textColorSecondary" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:paddingTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kb_short_undo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Undo (Z)"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kb_short_redo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Redo (Y)"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kb_short_save"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Save (S)"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kb_short_paste"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Paste (V)"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kb_short_cut"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Cut (X)"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kb_short_copy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Copy (C)"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kb_short_all"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="All (A)"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kb_short_find"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Find (F)"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kb_short_replace"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="Replace (H)"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="?attr/colorOnSurface" />
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/keyboard_text_device_info"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="20"
        android:background="?attr/colorSurface"
        android:text="@string/device_not_connected"
        android:textAlignment="center"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>
