<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context="com.example.alek.ble_hid_example.MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/keyboard_sub_main_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="beforeDescendants"
            android:focusableInTouchMode="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/keyboard"
                android:textAlignment="center"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#1f2937"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#374151"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/colorPrimary"
                        app:hintTextColor="@color/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/keyboard_edit_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/enter_text"
                            android:textColor="@color/colorWhite"
                            android:nextFocusLeft="@id/keyboard_edit_text"
                            android:nextFocusUp="@id/keyboard_edit_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyboard_button_send"
                        style="@style/ModernButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/send_text"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Single Character & Control Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#1f2937"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#374151"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/send_single_character"
                        android:textAlignment="center"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/keyboard_spinner_character"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/modern_button_bg"
                        android:spinnerMode="dialog" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyboard_toggle_kb"
                        style="@style/ModernButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:checkable="true"
                        android:text="@string/keyboard_off"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/keyboard_lock_num"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:checkable="true"
                            android:text="NUM"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/keyboard_lock_caps"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:checkable="true"
                            android:text="CAPS"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/keyboard_lock_scroll"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:checkable="true"
                            android:text="SCRL"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Shortcuts Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#1f2937"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#374151"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Shortcuts (CTRL+)"
                        android:textAlignment="center"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="12sp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kb_short_undo"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:text="Undo (Z)"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kb_short_redo"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:text="Redo (Y)"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kb_short_save"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:text="Save (S)"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kb_short_paste"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:text="Paste (V)"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kb_short_cut"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:text="Cut (X)"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kb_short_copy"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:text="Copy (C)"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kb_short_all"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:text="All (A)"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kb_short_find"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:text="Find (F)"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kb_short_replace"
                            style="@style/ModernButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:text="Replace (H)"
                            android:textSize="10sp" />
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/keyboard_text_device_info"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="8dp"
        android:background="@drawable/device_info_bg"
        android:gravity="center"
        android:text="@string/device_not_connected"
        android:textColor="@color/colorWhite"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
