<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:orientation="vertical">

    <WebView
        android:id="@+id/blockly_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#1f2937"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="#374151"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_script"
                style="@style/ModernButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/blockly_run"
                android:backgroundTint="#10b981"
                android:textSize="12sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <ImageButton
                android:id="@+id/btn_clear_blocks"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/colorWhite"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/blockly_clear_workspace" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_save_blocks"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/colorWhite"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/blockly_save" />

            <ImageButton
                android:id="@+id/btn_load_blocks"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_upload"
                app:tint="@color/colorWhite"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/blockly_load" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
