<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    tools:context="com.example.alek.ble_hid_example.MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/d_pad"
                android:textAlignment="center"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- D-Pad Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#1f2937"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#374151"
                app:strokeWidth="1dp">

                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="16dp"
                    android:columnCount="3"
                    android:rowCount="3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/d_pad_up"
                        style="@style/ModernButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_column="1"
                        android:layout_row="0"
                        android:layout_margin="4dp"
                        app:icon="@drawable/ic_arrow_upward_black_24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="32dp"
                        app:iconTint="@color/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/d_pad_left"
                        style="@style/ModernButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_column="0"
                        android:layout_row="1"
                        android:layout_margin="4dp"
                        app:icon="@drawable/ic_arrow_back_black_24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="32dp"
                        app:iconTint="@color/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/d_pad_right"
                        style="@style/ModernButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_column="2"
                        android:layout_row="1"
                        android:layout_margin="4dp"
                        app:icon="@drawable/ic_arrow_forward_black_24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="32dp"
                        app:iconTint="@color/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/d_pad_down"
                        style="@style/ModernButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_column="1"
                        android:layout_row="2"
                        android:layout_margin="4dp"
                        app:icon="@drawable/ic_arrow_downward_black_24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="32dp"
                        app:iconTint="@color/colorOnSurface" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/d_pad_text_device_info"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="8dp"
        android:background="@drawable/device_info_bg"
        android:gravity="center"
        android:text="@string/device_not_connected"
        android:textColor="@color/colorWhite"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
