<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44FFFFFF">
    <item>
        <layer-list>
            <!-- Bottom "3D" shadow/depth -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#111827" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <!-- Main button body -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/button_bg_end"
                        android:startColor="@color/button_bg_start"
                        android:type="linear" />
                    <corners android:radius="24dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/button_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
