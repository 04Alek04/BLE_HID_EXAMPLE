<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp" android:left="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#4f46e5" />
                    <corners android:radius="40dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Shadow -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#111827" />
                    <corners android:radius="40dp" />
                </shape>
            </item>
            <!-- Body -->
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#374151"
                        android:startColor="#4b5563"
                        android:type="linear" />
                    <corners android:radius="40dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#9ca3af" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
